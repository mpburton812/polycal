# PolyCal environment variables (copy to .env.local — never commit secrets)

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=feature

# --- Turso (remote) or omit for local file:local.db ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Auth.js (credentials) — required ---
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Jira sync (CI only — optional for local) ---
JIRA_BASE_URL=https://mpburton.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_DONE_TRANSITION_NAME=Done
