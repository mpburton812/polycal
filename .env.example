# PolyCal environment variables (copy to .env.local — never commit secrets)

# --- App ---
NODE_ENV=development

# --- Turso (test / production — not used for local feature/dev SQLite) ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Auth (Auth.js / NextAuth — add when scaffolded) ---
AUTH_SECRET=
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Jira sync (CI only — optional for local) ---
JIRA_BASE_URL=https://mpburton.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_DONE_TRANSITION_NAME=Done
