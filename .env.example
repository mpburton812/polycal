# PolyCal environment variables (copy to .env.local — never commit secrets)

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=feature

# --- Turso (remote) or omit for local file:local.db ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Auth.js (credentials) — required ---
AUTH_SECRET=
# Local default is fine for feature/dev. Production (NEXT_PUBLIC_APP_ENV=production
# or TURSO URL containing polycal-prod) refuses localhost AUTH_URL at startup.
AUTH_URL=http://localhost:3000
# Admin impersonation (User management). Required to enable Impersonate; never reuse AUTH_SECRET.
AUTH_IMPERSONATION_SECRET=

# Comma-separated origins allowed for alpha-feedback tracker CORS in production (PC-282).
# Localhost tracker variants are always included. Example:
# ALPHA_FEEDBACK_CORS_ORIGINS=https://tracker.example.com
ALPHA_FEEDBACK_CORS_ORIGINS=

# --- Cron enforcement (Vercel + Render) ---
CRON_SECRET=

# --- Email (Resend — optional; log-only when unset) ---
RESEND_API_KEY=
EMAIL_FROM=PolyCal <notifications@yourdomain.com>

# --- Jira sync (CI only — optional for local) ---
JIRA_BASE_URL=https://mpburton.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_DONE_TRANSITION_NAME=Done
