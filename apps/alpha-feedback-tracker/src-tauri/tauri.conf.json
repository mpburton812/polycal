{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PolyCal Alpha Feedback Tracker",
  "version": "0.1.0",
  "identifier": "app.polycal.alpha-feedback-tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PolyCal Alpha Feedback Tracker",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "wix": null,
      "nsis": null
    }
  }
}
