# Copy to .env.vercel-setup (gitignored) for scripts/sync-vercel-preview-env.mjs
# Generate tokens: .\scripts\turso.ps1 db tokens create polycal-dev --expiration never
#                    .\scripts\turso.ps1 db tokens create polycal-test --expiration never
#                    .\scripts\turso.ps1 db tokens create polycal-prod --expiration never

AUTH_SECRET=

# Per-database Turso tokens (required — do not reuse across databases)
TURSO_AUTH_TOKEN_DEV=
TURSO_AUTH_TOKEN_TEST=
TURSO_AUTH_TOKEN_PROD=

# Optional fallback used only for dev if TURSO_AUTH_TOKEN_DEV is unset
TURSO_AUTH_TOKEN=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# Server-side keys used when sending push from notifyUser / sendPushToUser
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact for push service identification (required by web-push)
VAPID_SUBJECT=mailto:admin@example.com
# Client-side key for PushManager.subscribe (must match VAPID_PUBLIC_KEY)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Transactional email via Resend (notification.email_* activity log)
RESEND_API_KEY=
EMAIL_FROM=PolyCal <notifications@example.com>

# Google Calendar OAuth (Option B — connect only, not login)
# Create in Google Cloud Console: enable Calendar API, OAuth consent (scopes
# calendar.events + calendar.calendarlist.readonly), Web client with redirect:
#   http://localhost:3000/api/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
# AES key for encrypting Google refresh tokens at rest (e.g. openssl rand -base64 32)
CALENDAR_TOKEN_ENCRYPTION_KEY=
